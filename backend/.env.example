DB_HOST=localhost
DB_PORT=5432
DB_NAME=garbage_management
DB_USER=postgres
DB_PASSWORD=replace-with-local-postgres-password

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional comma-separated browser origins for Flutter Web on a LAN host.
CORS_ALLOWED_ORIGINS=

# Uploaded evidence files are stored here; keep this directory out of source control.
MEDIA_STORAGE_DIR=uploads
